<?xml version="1.0" encoding="UTF-8"?>
<!--
     This file contains metadata and properties for conference websites.

     FOR MONOLINGUAL SITES:
    - Simply encode text content within each property element.

     FOR BILINGUAL SITES:
    - For each property, create a separate child element for each language specified in the languages section.

     EXAMPLE:
     Monolingual: <siteTitle>My Site Title</siteTitle>
     Bilingual:   <siteTitle>
                        <fr>My Site Title</fr>
                        <de>Mein Seitentitel</de>
                    </siteTitle>
-->
<site>
  <!-- Homepage source: simple template or content XML with or without shared site chrome.
  Use simple in cases where you want a minimal landing page (eg. a conference website)
  Use content when you basically want the landing page to be a content page, with lots of content, a top menu, and a footer.
  Use complex for a custom landing page built from index.xml without the top navigation or footer.
  -->
  <landingPageMode>simple</landingPageMode>
  <!--This list of languages defines all of the languages that the site will be built in.
         The build process will pull this list of languages and use that to create the necessary build targets and outputs.
         You can overwrite this logic by running the build with -Dlanguages and specifying just the language(s) you want -->
  <languages>
    <lang code="en" label="English" default="true"/>
  </languages>
  <files>
    <cssFile>css/rra.css</cssFile>
    <jsFile>js/ux.js</jsFile>
    <faviconIco>images/uvic-favicon.png</faviconIco>
    <!--<faviconSvg>images/favicon.svg</faviconSvg>-->
    <siteManifest>site.webmanifest</siteManifest>
  </files>
  <metadata>
    <!-- Public base URL used to generate canonical links. Keep the trailing slash. -->
    <siteUrl>https://FutureOfRRA.uvic.ca/</siteUrl>
    <siteTitle>
      <en>Shaping the Future of Research Assessment</en> 
    </siteTitle>
    <siteSubtitle>
      <en>A Canadian Strategy</en>
    </siteSubtitle>
    <metaDescription>
      <en>Website for the Shaping the Future of Research Assessment—A Canadian Strategy workshop</en>
    </metaDescription>
    <preTitle>
      <en>Pre-title text in splash header stack, if any</en>
    </preTitle>
    <organizationName>
      <en>Organization Name</en>
    </organizationName>
    <contactEmail>
            info@FutureOfRRA.uvic.ca <!--Check if this needs to be changed-->
        </contactEmail>
    <WhereWhen>
      <place>
        <en>University Club</en>
      </place>
      <date>
        <en>June 8-10, 2027</en>
      </date>
      <dateIso>2027-06-09/2027-06-10</dateIso>
      <location>
        <en>University of Victoria</en>
      </location>
    </WhereWhen>
  </metadata>
  <!--Uncomment this and update the heading options if you want to have a language selector splash page-->
  <!-- For language selector page -->
  <!--<languageSelector>
        <heading>
            <en>Select your language</en>
            <de>Wählen Sie Ihre Sprache</de>
        </heading>
    </languageSelector>-->
  <!--The element labels here follow CSS conventions. If you want to add an attribute to a specific element, add it as a child element. -->
  <!-- For nav.aria-label-->
  <nav-aria-label>
    <en>Language Selection</en>
  </nav-aria-label>
  <!--For img.splash-logo-->
  <splash-logo>
    <class>splash-logo</class>
    <src>images/logo-splash.webp</src>
    <en>Alt text for main site logo, if any</en>
  </splash-logo>
  <!--For img.uvic-logo-->
  <uvic-logo>
    <href>https://uvic.ca</href>
    <src>images/UVIC-VRGB-Blue.svg</src>
    <width>300</width>
    <alt>
      <en>University of Victoria</en>
    </alt>
  </uvic-logo>
  <!--For img.mobile-header splash page-->
  <mobile-header-splash>
    <class>mobile-header-splash</class>
    <src>images/logo-mobile-header.webp</src>
    <alt>
      <en/>
    </alt>
  </mobile-header-splash>
  <!--For img.mobile-header internal pages-->
  <mobile-header-internal>
    <class>mobile-header-internal</class>
    <src>images/logo-mobile-header.webp</src>
    <alt>
      <en>Alt text for mobile header logo, if any. Change language element as needed.</en>
    </alt>
  </mobile-header-internal>
  <!--For popover.splash-icon. Assuming no alt text for this.-->
  <popover-splash-icon>
    <src>images/logo-mobile-popover.webp</src>
    <alt/>
  </popover-splash-icon>
  <!-- For a.skip-link-->
  <skip-link>
    <en>Skip to Content</en>
  </skip-link>
  <!-- For nav.aria-label-->
  <site-navigation-label>
    <en>Primary</en>
  </site-navigation-label>
  <!-- For subnav.aria-label-->
  <subnav-aria-label>
    <en>Secondary</en>
  </subnav-aria-label>
  <!--For button.aria-label-->
  <popover-close-label>
    <en>Close</en>
  </popover-close-label>
  <!--For span.nav-toggle-label-->
  <nav-toggle-label>
    <en>Site Menu</en>
  </nav-toggle-label>
  <!--For div.footer-container-->
  <footer-content>
    <items>
      <item>
        <?uvic-logo?>
      </item>
    </items>
  </footer-content>
  <!-- For div.popover-nav-items. Replace these with your actual navigation items.
         If you are doing a bilingual build, supply each item with an element for each language (eg. <en> and <fr>). -->
  <navigation>
    <item href="index.html">
      <en>Home</en>
    </item>
    <item href="about.html">
      <en>About</en>
    </item>
    <item href="program.html">
      <en>Program</en>
    </item>
    <item href="speakers.html">
      <en>Speakers</en>
    </item>
    <item href="registration.html">
      <en>Registration</en>
    </item>
    <item href="gettinghere.html">
      <en>Getting Here</en>
    </item>
    <item href="information.html">
      <en>Information</en>
    </item>
  </navigation>
</site>
