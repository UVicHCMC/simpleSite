// Project tasks configuration. See https://zed.dev/docs/tasks for documentation.
[
  {
    "label": "Commons: Sass",
    "command": "sass",
    "args": [
      "--watch",
      "--style=expanded",
      "--source-map",
      "--embed-sources",

      // Format: input SCSS file:output CSS file
      "scss/commons.scss:css/commons.css",
    ],
    "cwd": "/Users/pszpak/Developer/commons",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "no_focus",
    "hide": "never",
  },
  {
    "label": "Commons: BrowserSync",

    // Uses the globally installed BrowserSync command.
    "command": "browser-sync",
    "args": [
      "start",

      // Serve source assets from the project root and generated HTML from site.
      "--server",
      "site",
      "--serveStatic",
      ".",
      "--files",
      "css",
      "site",
    ],
    "cwd": "/Users/pszpak/Developer/commons",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "no_focus",
    "hide": "never",
  },
]
