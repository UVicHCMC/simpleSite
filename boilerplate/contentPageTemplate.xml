<?xml version="1.0"?>
<html xmlns="http://www.w3.org/1999/xhtml" lang="en">
  <head xmlns="http://www.w3.org/1999/xhtml">
    <title>
      <?siteTitle?>
    </title>
    <!-- Core metadata -->
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <!-- Page-specific values are supplied by processContent.xsl. -->
    <meta name="description" content=""/>
    <link rel="canonical" href=""/>
    <link rel="stylesheet" href="{?cssFile}"/>
    <script src="{?jsFile}" defer="defer" />
    <!-- Favicons / PWA -->
    <link rel="icon" href="{?faviconIco}" sizes="48x48"/>
    <link rel="manifest" href="{?siteManifest}"/>
  </head>
  <body id="top">
    <div class="content-wrapper page-grid">
      <div class="top-wrapper full-bleed inherit-page-grid">
        <header id="site-header" class="site-masthead breakout">
          <a href="#content" class="skip-link"><?skip-link?></a>
          <div class="nav-wrapper">
            <div class="button-wrapper">
              <button id="site-menu-toggle" class="popover-nav-open" type="button" popovertarget="site-navigation" popovertargetaction="toggle" aria-controls="site-navigation" aria-haspopup="true" aria-expanded="false">
                <span class="nav-toggle-label"><?nav-toggle-label?></span>
                <svg xmlns="http://www.w3.org/2000/svg" class="menu-burger" width="24" height="24" fill="none" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12h18M3 6h18M3 18h18"/>
                </svg>
              </button>
              <nav id="site-navigation" class="main-menu" aria-label="{?site-navigation-label}" popover="auto">
                <button type="button" class="popover-nav-close" aria-label="{?popover-close-label}" popovertarget="site-navigation" popovertargetaction="hide">
                  <svg xmlns="http://www.w3.org/2000/svg" class="close-x" width="24" height="24" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 6 6 18M6 6l12 12"/>
                  </svg>
                </button>
                <div class="popover-group-container">
                  <div class="popover-header">
                    <p class="popover-header-text"><?siteTitle?></p>
                  </div>
                  <ul class="popover-nav-items"><?navigation?></ul>
                </div>
              </nav>
            </div>
          </div>
        </header>
      </div>
      <main class="full-bleed inherit-page-grid" id="content">
        <div class="main-wrapper full-bleed inherit-page-grid">
          <!-- NOTE: This processing-instruction will be replaced by the document
                             content. -->
          <?docContent?>
        </div>
      </main>
      <footer class="full-bleed inherit-page-grid">
        <div class="footer-accent-container breakout">
          <a href="index.html">
            <img class="logo-footer" src="images/logo-footer.webp" alt=""/>
          </a>
        </div>
      </footer>
    </div>
    <a class="scroll-to-top" href="#top" aria-hidden="true" inert="">
      <svg xmlns="http://www.w3.org/2000/svg" class="up-caret" width="20" height="20" fill="none" viewBox="0 0 20 20" aria-hidden="true">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m5 12 5-5 5 5"/>
      </svg>
      <span>Back to top</span>
    </a>
  </body>
</html>
