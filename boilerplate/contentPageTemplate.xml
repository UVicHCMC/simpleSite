<?xml version="1.0"?>
<html xmlns="http://www.w3.org/1999/xhtml" lang="en">
  <head xmlns="http://www.w3.org/1999/xhtml">
    <title>
      <?siteTitle?>
    </title>
    <!-- Core metadata -->
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <!-- Compiled styles (includes page grid + layout system) -->
    <link rel="stylesheet" href="{?cssFile}"/>
    <!-- Script -->
    <script src="{?jsFile}"/>
    <!-- Favicons / PWA -->
    <link rel="icon" href="{?faviconIco}" sizes="48x48"/>
    <link rel="icon" href="{?faviconSvg}" sizes="any" type="image/svg+xml"/>
    <link rel="manifest" href="{?siteManifest}"/>
  </head>
  <body id="top">
    <div class="content-wrapper">
      <div class="top-wrapper full-bleed">
        <header>
          <nav id="mainMenu" aria-label="{?site-navigation-label}">
            <button class="mobile-menu-close">
              Close
              <svg xmlns="http://www.w3.org/2000/svg" class="x-closer" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 6 6 18M6 6l12 12"/></svg>
            </button>
            <ul>
              <li class="top-bar-logo">
                <a href="index.html">
                  <img class="site-logo-top" src="images/site-logo-internal.webp" alt="{?siteTitle}"/>
                  <span class="siteTitle">
                    <?siteTitle?>
                  </span>
                </a>
              </li>
              <?navigation?>
            </ul>
          </nav>
          <nav class="mobile-top-nav">
            <ul>
              <li>
                <a href="index.html">
                  <img class="site-logo-mobile" src="images/site-logo-internal.webp" width="100" height="38" alt="{?siteTitle}"/>
                </a>
              </li>
              <li>
                <a class="search-link" href="search.html">
                  Search
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 16 16" class="magnifying-glass"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="m14 14-4-4m1.333-3.333a4.667 4.667 0 1 1-9.333 0 4.667 4.667 0 0 1 9.333 0">
                                  </path></svg>
                </a>
              </li>
            </ul>
          </nav>
          <button class="mobile-menu-open" aria-controls="mainMenu" aria-expanded="false">
            Menu
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 18 18" class="menu-burger"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 9h13.5M2.25 4.5h13.5m-13.5 9h13.5"/></svg>
          </button>
        </header>
      </div>
      <main class="page-grid" id="content">
        <div class="main-wrapper">
          <!-- NOTE: This processing-instruction will be replaced by the document
                             content. -->
          <?docContent?>
        </div>
      </main>
      <footer class="full-bleed">
        <div class="footer-wrapper inline">
          <ul class="footer-list">
            <?navigation?>
          </ul>
        </div>
        <div class="footer-accent-container">
          <a href="index.html">
            <img class="logo-footer" src="images/logo-footer.webp" alt=""/>
          </a>
        </div>
      </footer>
    </div>
    <script src="js/ux.js"/>
  </body>
</html>
