                    <dt class="visually-hidden">Date</dt>
                    <dd>
                      <time datetime="2026-09-15">
                        <span class="month">September</span>
                        <span class="day">15</span>
                      </time>
                    </dd>
                  </div>
                  <div class="location">
                    <dt class="visually-hidden">Location</dt>
                    <dd>Critical Humanities Commons</dd>
                  </div>
                  <div class="time">
