<?xml version="1.0"?>
<html xmlns="http://www.w3.org/1999/xhtml" lang="en">
  <head xmlns="http://www.w3.org/1999/xhtml">
    <title>
      <?siteTitle?>
    </title>
    <!-- Core metadata -->
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
