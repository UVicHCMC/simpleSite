<?xml version="1.0"?>
<html xmlns="http://www.w3.org/1999/xhtml" lang="en">
  <head xmlns="http://www.w3.org/1999/xhtml">
    <title>
      <?siteTitle?>
    </title>
    <!-- Core metadata -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Homepage values are supplied by processLandingPage.xsl. -->
    <meta name="description" content="" />
    <link rel="canonical" href="" />
    <!-- Compiled styles (includes page grid + layout system) -->
    <link rel="stylesheet" href="{?cssFile}" />
    <!-- Script -->
    <script src="{?jsFile}" defer="defer" />
    <!-- Favicons / PWA -->
    <link rel="icon" href="{?faviconIco}" sizes="48x48" />
    <link rel="icon" href="{?faviconSvg}" sizes="any" type="image/svg+xml" />
    <link rel="manifest" href="{?siteManifest}" />
  </head>
  <body id="top">
    <div class="content-wrapper page-grid">
      <div class="top-wrapper full-bleed inherit-page-grid">
        <header class="breakout">
          <nav id="mainMenu" aria-label="{?site-navigation-label}">
            <button class="mobile-menu-close"> Close <svg xmlns="http://www.w3.org/2000/svg" class="x-closer" width="24" height="24" fill="none" viewBox="0 0 24 24">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 6 6 18M6 6l12 12" />
              </svg>
            </button>
            <ul>
              <li class="top-bar-logo">
                <a href="/">
                  <img class="site-logo-top" src="images/site-logo-internal.webp" alt="{?siteTitle}" />
                  <span class="siteTitle">
                    <?siteTitle?>
                  </span>
                </a>
              </li>
              <?navigation?>
            </ul>
          </nav>
          <nav class="mobile-top-nav">
            <ul>
              <li>
                <a href="/">
                  <img class="site-logo-mobile" src="images/site-logo-internal.webp" width="100" height="38" alt="{?siteTitle}" />
                </a>
              </li>
            </ul>
          </nav>
          <button class="mobile-menu-open" aria-controls="mainMenu" aria-expanded="false"> Menu <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 18 18" class="menu-burger">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 9h13.5M2.25 4.5h13.5m-13.5 9h13.5" />
            </svg>
          </button>
        </header>
      </div>
      <div class="hero full-bleed inherit-page-grid">
        <div class="hero-content-container breakout">
          <div class="logo-container">
            <img class="splash-logo" src="images/splash-logo.webp" alt="" />
            <h1 class="visually-hidden">Critical Humanities Commons: Rooted in Care. Driven by Ideas</h1>
          </div>
          <div class="intro-text"> The Critical Humanities Commons is a space where interdisciplinary scholarship unfolds through creativity, conversation, and commitment to social justice. Located at the heart of the Faculty of Humanities, the Commons brings people together to think, learn, and teach across disciplines to create new approaches for public dialogue. </div>
        </div>
      </div>
      <main id="content" class="full-bleed inherit-page-grid">
        <div class="main-wrapper splash full-bleed inherit-page-grid">
          <section class="event-band breakout" aria-labelledby="events-heading">
            <div class="splash-band-wrapper">
              <h2 id="events-heading" class="splash-heading">Upcoming events</h2>
              <!-- Replace this article with any event article copied from content/calendar.xml. -->
              <article class="event-container calendar-event" aria-labelledby="event-october-19-title">
                <time class="event-date" datetime="2026-10-19">
                  <span class="event-weekday">Monday</span>
                  <span class="event-month">October</span>
                  <span class="event-day">19</span>
                  <span class="event-year">2026</span>
                </time>
                <img class="calendar-event-image" src="images/public-history-talks-tours.webp" width="400" height="400" alt="" loading="lazy" decoding="async" />
                <div class="event-summary">
                  <h3 id="event-october-19-title" class="calendar-event-title">When Historians Say ‘Genocide’: A Public History Roundtable</h3>
                  <a class="event-button" href="https://events.uvic.ca/humanities/event/111544-public-history-talks-tours-series">Event details</a>
                </div>
              </article>
              <a class="calendar-button" href="calendar.html">View full calendar</a>
            </div>
          </section>
          <section class="pillars-section full-bleed inherit-page-grid" aria-labelledby="pillars-heading">
            <h2 id="pillars-heading" class="pillars-heading breakout">Critical Humanities Commons: Four Pillars</h2>
            <ul class="pillar-container breakout">
              <li class="pillar">
                <h3>Expertise</h3>
                <p>We deepen scholarly inquiry and challenge the boundaries of disciplinary knowledge.</p>
                <img class="pillar-icon" src="images/icon-expertise.svg" width="64" height="64" alt="" />
              </li>
              <li class="pillar">
                <h3>Collaboration</h3>
                <p>We work across fields to build sustained, trans-disciplinary research and relationships.</p>
                <img class="pillar-icon" src="images/icon-collaboration.svg" width="64" height="64" alt="" />
              </li>
              <li class="pillar">
                <h3>Exchange</h3>
                <p>We foster reciprocal learning and critical dialogue with diverse stakeholders.</p>
                <img class="pillar-icon" src="images/icon-exchange.svg" width="64" height="64" alt="" />
              </li>
              <li class="pillar">
                <h3>Dissemination</h3>
                <p>We ensure scholarship and dialogue have a tangible impact on wider publics.</p>
                <img class="pillar-icon" src="images/icon-dissemination.svg" width="64" height="64" alt="" />
              </li>
            </ul>
          </section>
          <section class="subscribe-section" aria-labelledby="subscribe-heading">
            <h2 id="subscribe-heading">Subscribe for more Critical Humanities Commons news and updates</h2>
            <a class="subscribe-button" href="mailto:muktalawrence@uvic.ca">Subscribe by email</a>
          </section>
        </div>
      </main>
      <footer class="full-bleed inherit-page-grid">
        <div class="footer-wrapper inline breakout">
          <ul class="footer-list">
            <?navigation?>
          </ul>
        </div>
        <div class="footer-accent-container breakout">
          <a href="/">
            <img class="logo-footer" src="images/logo-footer.webp" alt="" />
          </a>
        </div>
      </footer>
    </div>
    <a class="scroll-to-top" href="#top" aria-hidden="true" inert="">
      <svg xmlns="http://www.w3.org/2000/svg" class="up-caret" width="20" height="20" fill="none" viewBox="0 0 20 20" aria-hidden="true">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m5 12 5-5 5 5" />
      </svg>
      <span>Back to top</span>
    </a>
  </body>
</html>
