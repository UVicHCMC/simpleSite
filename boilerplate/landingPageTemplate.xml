<?xml version="1.0"?>
<html xmlns="http://www.w3.org/1999/xhtml" lang="en" class="no-js">
  <head xmlns="http://www.w3.org/1999/xhtml">
    <title>
      <?siteTitle?>
    </title>
    <!-- Core metadata -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Homepage values are supplied by processLandingPage.xsl. -->
    <meta name="description" content="" />
    <link rel="canonical" href="" />
    <!-- Compiled site styles, including the splash and popover navigation. -->
    <link rel="stylesheet" href="{?cssFile}" />
    <!-- Script -->
    <script src="{?jsFile}" defer="defer" />
    <!-- Favicons / PWA -->
    <link rel="icon" href="{?faviconIco}" sizes="48x48" />
    <link rel="manifest" href="{?siteManifest}" />
  </head>
  <body id="top" class="splash">
    <a class="skip-link" href="#content"><?skip-link?></a>
    <div class="page-wrapper">
      <header>
        <div class="nav-wrapper">
          <div class="button-wrapper">
            <!-- Native popover controls match the splash navigation styles. -->
            <button class="popover-nav-open" type="button" popovertarget="site-navigation" popovertargetaction="show">
              <span class="nav-toggle-label"><?nav-toggle-label?></span>
              <svg xmlns="http://www.w3.org/2000/svg" class="menu-burger" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <path d="M2.25 4.5h13.5M2.25 9h13.5m-13.5 4.5h13.5" stroke-width="1.5" stroke-linecap="round" />
              </svg>
            </button>
            <nav id="site-navigation" popover="auto" aria-label="{?site-navigation-label}">
              <button class="popover-nav-close" type="button" popovertarget="site-navigation" popovertargetaction="hide">
                <?popover-close-label?>
                <svg xmlns="http://www.w3.org/2000/svg" class="close-x" width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="m6 6 12 12M6 18 18 6" stroke-width="2" stroke-linecap="round" />
                </svg>
              </button>
              <div class="popover-group-container">
                <div class="popover-header">
                  <div class="popover-text">
                    <span class="site-title"><?siteTitle?></span>
                    <span class="site-subtitle"><?siteSubtitle?></span>
                    <span class="location"><?place?></span>
                    <span class="location"><?location?></span>
                    <span class="date"><?date?></span>
                  </div>
                </div>
                <ul class="popover-nav-items"><?navigation?></ul>
              </div>
            </nav>
          </div>
        </div>
      </header>
      <!-- Simple mode takes its conference details from properties.xml. -->
      <main id="content" class="top-logo-container-splash">
        <!--<img class="splash-logo logo-splash" src="images/UVIC-VRGB-UVIC-Blue.svg" alt="University of Victoria" width="300" />-->
        <div class="splash-header-stack">
          <?uvic-logo?>
          <h1 class="site-title"><?siteTitle?></h1>
          <h2 class="site-subtitle"><?siteSubtitle?></h2>
          <p class="location-two"><?location?></p>
          <p class="date"><?date?></p>
          <p class="contact-us"><a href="mailto:{?contactEmail}"><?contactEmail?></a></p>
        </div>
      </main>
    </div>
  </body>
</html>
